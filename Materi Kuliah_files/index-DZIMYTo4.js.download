# 27. Membuat Cover Point

Buat:

\`\`\`text
Scripts/AI/CoverPoint.cs
\`\`\`

Kode:

\`\`\`csharp
using UnityEngine;

public class CoverPoint : MonoBehaviour
{
    public bool IsOccupied
    {
        get;
        private set;
    }

    public EnemyTacticalAI OccupiedBy
    {
        get;
        private set;
    }

    public bool TryReserve(
        EnemyTacticalAI enemy
    )
    {
        if (IsOccupied &&
            OccupiedBy != enemy)
        {
            return false;
        }

        IsOccupied = true;
        OccupiedBy = enemy;

        return true;
    }

    public void Release(
        EnemyTacticalAI enemy
    )
    {
        if (OccupiedBy != enemy)
            return;

        IsOccupied = false;
        OccupiedBy = null;
    }

    private void OnDrawGizmos()
    {
        Gizmos.DrawWireSphere(
            transform.position,
            0.35f
        );
    }
}
\`\`\`

